{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VidMuse Public Style Hypothesis",
  "type": "object",
  "required": [
    "hypothesisId",
    "anonymousCandidateId",
    "anonymousLabel",
    "anchor",
    "scope",
    "signature",
    "evidence",
    "boundary",
    "aiRecommendation"
  ],
  "properties": {
    "hypothesisId": {
      "type": "string",
      "minLength": 1
    },
    "anonymousCandidateId": {
      "type": "string",
      "pattern": "^anon-[A-Za-z0-9_-]+$"
    },
    "anonymousLabel": {
      "type": "string",
      "pattern": "^Cluster [0-9]{4,}$"
    },
    "anchor": {
      "type": "object",
      "required": [
        "type",
        "name",
        "scope"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "media",
        "contentDependency"
      ],
      "properties": {
        "media": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contentDependency": {
          "type": "object",
          "required": [
            "mode",
            "values"
          ],
          "properties": {
            "mode": {
              "enum": [
                "none",
                "preferred",
                "required"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "evidence": {
      "type": "object",
      "required": [
        "coreEvidenceIds",
        "variationEvidenceIds"
      ],
      "properties": {
        "coreEvidenceIds": {
          "$ref": "#/$defs/nonemptyIds"
        },
        "variationEvidenceIds": {
          "$ref": "#/$defs/idList"
        }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "aiRecommendation": {
      "type": "object",
      "required": [
        "outcome",
        "confidence",
        "reason"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "advance",
            "merge",
            "split",
            "hold",
            "reject"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonemptyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariant": {
      "type": "object",
      "required": [
        "dimension",
        "rule",
        "evidenceIds"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIds": {
          "$ref": "#/$defs/nonemptyIds"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "summary",
        "transferableInvariants",
        "allowedVariation",
        "excludedSourceMotifs"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "transferableInvariants": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/invariant"
          }
        },
        "allowedVariation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludedSourceMotifs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "siblingExclusion": {
      "type": "object",
      "required": [
        "childSourceGroupKeys",
        "broadSideSourceGroupKeys",
        "coverageRationale"
      ],
      "properties": {
        "childSourceGroupKeys": {
          "$ref": "#/$defs/nonemptyIds"
        },
        "broadSideSourceGroupKeys": {
          "$ref": "#/$defs/nonemptyIds"
        },
        "coverageRationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": [
        "jointTestId",
        "neighborHypothesisId",
        "relationTest",
        "targetEvidenceIds",
        "neighborEvidenceIds",
        "distinguishingRules",
        "status"
      ],
      "properties": {
        "jointTestId": {
          "type": "string",
          "minLength": 1
        },
        "neighborHypothesisId": {
          "type": "string",
          "minLength": 1
        },
        "relationTest": {
          "enum": [
            "peer",
            "parent_child",
            "duplicate"
          ]
        },
        "targetRole": {
          "enum": [
            "peer",
            "parent",
            "child"
          ]
        },
        "neighborRole": {
          "enum": [
            "peer",
            "parent",
            "child"
          ]
        },
        "targetEvidenceIds": {
          "$ref": "#/$defs/idList"
        },
        "neighborEvidenceIds": {
          "$ref": "#/$defs/idList"
        },
        "distinguishingRules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "available",
            "insufficient"
          ]
        },
        "insufficiencyReason": {
          "type": "string",
          "minLength": 1
        },
        "siblingExclusion": {
          "$ref": "#/$defs/siblingExclusion"
        }
      },
      "additionalProperties": false
    }
  }
}
