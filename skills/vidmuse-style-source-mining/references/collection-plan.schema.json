{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VidMuse Source Collection Plan",
  "type": "object",
  "required": [
    "source",
    "media",
    "evidenceUnit",
    "collection",
    "coverage",
    "rights",
    "pilot",
    "channelMapping"
  ],
  "properties": {
    "source": {
      "type": "object",
      "required": [
        "name",
        "urls"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceUnit": {
      "type": "object",
      "required": [
        "unitType",
        "capabilities",
        "sourceGroupPolicy",
        "contextPolicy",
        "independencePolicy"
      ],
      "properties": {
        "unitType": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 1
        },
        "sourceGroupPolicy": {
          "type": "string",
          "minLength": 1
        },
        "contextPolicy": {
          "type": "string",
          "minLength": 1
        },
        "independencePolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "collection": {
      "type": "object",
      "required": [
        "primaryRoute",
        "checkpointKey",
        "dedupeKey"
      ],
      "properties": {
        "primaryRoute": {
          "type": "string",
          "minLength": 1
        },
        "checkpointKey": {
          "type": "string",
          "minLength": 1
        },
        "dedupeKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "catalogSnapshot",
        "target",
        "strata",
        "stopConditions"
      ],
      "properties": {
        "catalogSnapshot": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "strata": {
          "type": "array",
          "minItems": 1
        },
        "stopConditions": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "rights": {
      "type": "object",
      "required": [
        "licenseStatus",
        "researchOnly"
      ]
    },
    "pilot": {
      "type": "object",
      "required": [
        "routesToExercise",
        "successConditions",
        "stopConditions"
      ]
    },
    "channelMapping": {
      "type": "object",
      "required": [
        "style",
        "content",
        "provenance"
      ]
    }
  },
  "additionalProperties": true
}
