{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidmuse.ai/schemas/evidence-record-v1.json",
  "title": "VidMuse EvidenceRecord",
  "type": "object",
  "required": [
    "evidenceId",
    "unitType",
    "medium",
    "source",
    "localAssetPath",
    "sourceGroupKey",
    "contextKey",
    "independenceKey",
    "styleFeatures",
    "contentFeatures",
    "evidenceCapabilities",
    "provenance",
    "licenseStatus",
    "researchOnly",
    "fileSha256",
    "differenceHash",
    "duplicateOf",
    "nearDuplicateOf"
  ],
  "properties": {
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "unitType": {
      "type": "string",
      "minLength": 1
    },
    "medium": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "localAssetPath": {
      "type": "string",
      "minLength": 1
    },
    "sourceGroupKey": {
      "type": "string",
      "minLength": 1
    },
    "contextKey": {
      "type": "string",
      "minLength": 1
    },
    "independenceKey": {
      "type": "string",
      "minLength": 1
    },
    "styleFeatures": {
      "type": "object"
    },
    "contentFeatures": {
      "type": "object"
    },
    "evidenceCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "anchorMemberships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "anchorType",
              "anchorName",
              "basis"
            ],
            "properties": {
              "anchorType": {
                "type": "string",
                "minLength": 1
              },
              "anchorName": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "licenseStatus": {
      "enum": [
        "research_only",
        "licensed",
        "generated",
        "public_domain",
        "unknown"
      ]
    },
    "researchOnly": {
      "type": "boolean"
    },
    "fileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "differenceHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "duplicateOf": {
      "type": [
        "string",
        "null"
      ]
    },
    "nearDuplicateOf": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
